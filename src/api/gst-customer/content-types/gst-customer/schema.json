{
  "kind": "collectionType",
  "collectionName": "gst_customers",
  "info": {
    "singularName": "gst-customer",
    "pluralName": "gst-customers",
    "displayName": "Gst Customer"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "unique": true
    },
    "address": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "gst_no": {
      "type": "text"
    },
    "gst_lists": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gst-list.gst-list",
      "mappedBy": "gst_customer"
    }
  }
}
